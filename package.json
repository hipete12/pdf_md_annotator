{
  "name": "pdf-annotator",
  "version": "1.1.0",
  "description": "PDF Viewer and Annotator with Markdown and LaTeX support",
  "main": "app-build/main/main.js",
  "scripts": {
    "dev": "node scripts/dev-runner.js",
    "build": "node scripts/build.js",
    "build:main": "webpack --config webpack.main.config.js --mode production",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').rmSync('app-build',{recursive:true,force:true})\"",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run clean && npm run build && electron-builder --publish never",
    "dist:linux": "npm run clean && npm run build && electron-builder --linux AppImage --x64 --publish never",
    "test": "node scripts/test-unit.js",
    "test:e2e": "playwright test",
    "lint": "eslint --ext .js,.vue src"
  },
  "author": "hipete12",
  "license": "MIT",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "dompurify": "^3.4.17",
    "electron-localshortcut": "^3.2.1",
    "electron-log": "^5.1.1",
    "electron-store": "^8.1.0",
    "katex": "^0.16.9",
    "marked": "^12.0.0",
    "pdfjs-dist": "^4.0.379",
    "prismjs": "^1.29.0",
    "snabbdom": "^3.5.1",
    "uuid": "^9.0.1",
    "vue": "^3.4.15",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@playwright/test": "^1.41.1",
    "@vue/compiler-sfc": "^3.4.15",
    "babel-loader": "^9.1.3",
    "chai": "^4.4.1",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.10.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.21.1",
    "html-webpack-plugin": "^5.6.0",
    "jsdom": "^24.1.3",
    "karma": "^6.4.2",
    "karma-chai": "^0.1.0",
    "karma-mocha": "^2.0.1",
    "karma-webpack": "^5.0.1",
    "mocha": "^10.2.0",
    "style-loader": "^3.3.4",
    "vue-loader": "^17.4.2",
    "webpack": "^5.90.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.0.0",
    "webpack-merge": "^5.10.0"
  },
  "build": {
    "appId": "com.pdfannotator.app",
    "productName": "PDF Annotator",
    "directories": {
      "output": "dist"
    },
    "afterPack": "scripts/afterPack.js",
    "files": [
      "app-build/**/*",
      "static/**/*"
    ],
    "asarUnpack": [
      "app-build/renderer/pdf.worker.min.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "static/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "category": "Office",
      "icon": "static/icons",
      "executableName": "pdf-annotator",
      "executableArgs": ["--sandbox-auto"],
      "synopsis": "PDF viewer and annotator with Markdown and LaTeX support",
      "description": "View and annotate PDFs with Markdown and LaTeX support.",
      "desktop": {
        "Name": "PDF Annotator",
        "Comment": "View and annotate PDF documents",
        "Keywords": "pdf;annotate;markdown;latex;",
        "StartupWMClass": "PDF Annotator"
      }
    },
    "appImage": {
      "artifactName": "${name}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF Document",
        "description": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      }
    ]
  }
}
